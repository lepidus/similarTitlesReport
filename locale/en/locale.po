msgid "plugins.generic.similarTitlesReport.displayName"
msgstr "Submissions with similar titles"

msgid "plugins.generic.similarTitlesReport.description"
msgstr "Lists active submission pairs in the current context with at least {$threshold}% title similarity."

msgid "plugins.generic.similarTitlesReport.menu"
msgstr "Similar titles"

msgid "plugins.generic.similarTitlesReport.noResults"
msgstr "No active submission pairs with at least {$threshold}% title similarity were found."

msgid "plugins.generic.similarTitlesReport.limit.submissions"
msgstr "To limit processing time and memory, the report considered only the {$maxSubmissions} most recent accessible active submissions."

msgid "plugins.generic.similarTitlesReport.limit.pairs"
msgstr "Only the {$maxPairs} pairs with the highest similarity were displayed."

msgid "plugins.generic.similarTitlesReport.column.similarity"
msgstr "Similarity"

msgid "plugins.generic.similarTitlesReport.column.submission"
msgstr "Submission"

msgid "plugins.generic.similarTitlesReport.column.authors"
msgstr "Authors"

msgid "plugins.generic.similarTitlesReport.column.similarSubmission"
msgstr "Similar submission"

msgid "plugins.generic.similarTitlesReport.column.similarAuthors"
msgstr "Similar submission authors"
